# URL de l'API backend (avec /api/v1).
# BACKEND_API_URL : lue à l'exécution par le serveur Next (rendu serveur du catalogue).
# NEXT_PUBLIC_BACKEND_API_URL : injectée dans le JS navigateur AU MOMENT DU BUILD
#   -> toute modification impose de relancer `npm run build:standalone`.
BACKEND_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000/api/v1
# Remontée des erreurs du serveur Next vers la supervision (même valeur que LOG_INGEST_KEY du backend).
# Variable serveur uniquement : ne jamais la préfixer par NEXT_PUBLIC_.
LOG_INGEST_KEY=

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/DATABASE
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/DATABASE_test
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
# Cookies de session HttpOnly (défauts : SameSite=lax, Secure en production, domaine de l'API)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SECURE=
# Codes OTP : none | console (dev uniquement, code affiché dans la console) | memory (tests)
# Vide = console en développement, none en production (connexion par téléphone masquée)
SMS_PROVIDER=
WHATSAPP_PROVIDER=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Tentatives de connexion par IP et par 15 min (garder 10 en production)
AUTH_RATE_LIMIT=10
LOG_LEVEL=info
# Logs fichier (rotation quotidienne, 14 jours) — chemin absolu hors public_html en mutualisé
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE=20m
SLOW_REQUEST_MS=1000
# Alertes e-mail sur erreur (vide = comptes DEV), regroupées par fenêtre de 15 min
ALERT_EMAILS=
ALERT_THROTTLE_MINUTES=15
# Secret partagé avec le serveur Next (même valeur dans les variables Vercel)
LOG_INGEST_KEY=
# --- Front ---
FRONTEND_URL=http://localhost:3000

# --- SMTP (optionnel en dev : sans SMTP_HOST les emails sont journalisés) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KEMI SHOES <no-reply@kemishoes.com>
# Vérification de l'adresse e-mail par code à l'inscription : auto (défaut) = active dès que SMTP_HOST est défini.
# En production sans SMTP, l'inscription par e-mail est refusée (503) plutôt qu'ouverte à n'importe quelle adresse.
EMAIL_VERIFICATION=auto

# --- CamPay (https://demo.campay.net en test, https://www.campay.net en live) ---
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_APP_PASSWORD=
# Token permanent (prioritaire) ; sinon un token est demandé avec USERNAME/APP_PASSWORD
CAMPAY_ACCESS_TOKEN=
CAMPAY_WEBHOOK_KEY=
# Compte demo : 25 XAF max par transaction. Supprimer après le Go Live.
CAMPAY_MAX_AMOUNT_XAF=25

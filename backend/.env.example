NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/DATABASE
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/DATABASE_test
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Tentatives de connexion par IP et par 15 min (garder 10 en production)
AUTH_RATE_LIMIT=10
LOG_LEVEL=info
# --- Front ---
FRONTEND_URL=http://localhost:3000

# --- SMTP (optionnel en dev : sans SMTP_HOST les emails sont journalisés) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KEMI SHOES <no-reply@kemishoes.com>

# --- CamPay (https://demo.campay.net en test, https://www.campay.net en live) ---
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_APP_PASSWORD=
# Token permanent (prioritaire) ; sinon un token est demandé avec USERNAME/APP_PASSWORD
CAMPAY_ACCESS_TOKEN=
CAMPAY_WEBHOOK_KEY=
# Compte demo : 25 XAF max par transaction. Supprimer après le Go Live.
CAMPAY_MAX_AMOUNT_XAF=25
